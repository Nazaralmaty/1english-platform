# Скопировать в .env (он в .gitignore) и заполнить из панели Supabase.
# В чат ключи не присылать — Claude читает их отсюда.

# Settings → API → Project URL
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Settings → API → anon public  (можно светить в браузере, он ограничен RLS)
SUPABASE_ANON_KEY=
# Settings → Database → Connection string → URI (с паролем базы).
# Нужен, чтобы применять schema.sql и смотреть данные без ручных запросов.
SUPABASE_DB_URL=postgresql://postgres:ПАРОЛЬ@db.xxxxxxxxxxxx.supabase.co:5432/postgres
# Account → Access Tokens (для supabase CLI, миграций и настроек проекта)
SUPABASE_ACCESS_TOKEN=
