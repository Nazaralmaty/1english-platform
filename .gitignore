.DS_Store
node_modules/

# Ключи Supabase и любые секреты. Репозиторий публичный — сюда не должно
# попасть ничего, что открывает доступ к базе.
.env
.env.*
!.env.example

# Промежуточные файлы сборки видео: восстанавливаются скриптами из media/script.
# В репозитории лежит только результат — mp4, постер и презентация.
media/frames/
media/seg/
media/vo/
media/u2/frames/
media/u2/seg/
media/u2/mix/
media/u2/vo/

# Мастерская ролика: 539 МБ кадров, звуков и рендеров. Это рабочие файлы
# монтажа, а не исходники платформы. Pages раздаёт весь репозиторий, поэтому
# сюда они не едут — на диске всё остаётся на месте.
media/b1_reel/
media/**/*.mp4
media/**/*.wav
